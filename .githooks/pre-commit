#!/usr/bin/env bash
# Public-repo hygiene: fosterstack/cache is public. Everything committed
# here is world-readable the moment it is pushed, permanently — forks,
# mirrors and GH Archive keep it, and making the repo private later does
# not undo it. This hook rejects staged files that don't match the
# allowlist in bin/check-file-allowlist.sh, so ops runbooks, sprint state,
# the brief, a stray .env or an editor swap file can't slip in on
# autopilot.
#
# This repo is also the one an agent may push to main autonomously for
# dependency bumps (brief §0.2(a)), which is exactly why it needs the
# mechanical backstop rather than relying on judgment alone.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# CI (.github/workflows/ci.yml) runs the same check as a backstop
# for commits made without this hook enabled.

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)

# Rule: judge only the staged changes THIS commit introduces.
#  - normal commit (also squash, cherry-pick, revert, rebase): the staged diff against HEAD.
#  - merge commit (MERGE_HEAD present, one line per other parent): only files that differ from
#    HEAD AND from every MERGE_HEAD parent, so content that merely came from another parent
#    (already tracked, already judged) is not re-judged, while anything the merge itself adds or
#    changes (e.g. a conflict resolution) still is.
files=$(git diff --cached --ignore-submodules=none --name-only --diff-filter=ACMRT)
# --ignore-submodules=none on every diff: diff.ignoreSubmodules / .gitmodules ignore=all must not hide a gitlink.
# LC_ALL=C for sort and comm: they must agree on one byte order whatever the user's locale (a locale-aware
# sort with a mismatched comm collation can drop or misorder paths and make the intersection wrong).
export LC_ALL=C
merge_head=$(git rev-parse --git-path MERGE_HEAD)
if [ -f "$merge_head" ]; then
  # sorted lists go into variables first so a failing git or sort aborts under set -e
  files=$(printf '%s\n' "$files" | sort -u)
  while read -r parent _; do
    [ -n "$parent" ] || continue
    other=$(git diff --cached --ignore-submodules=none --name-only "$parent")  # no status filter: any type, mode or content difference counts
    other=$(printf '%s\n' "$other" | sort -u)
    files=$(comm -12 <(printf '%s\n' "$files") <(printf '%s\n' "$other"))
  done < "$merge_head"
fi
printf '%s\n' "$files" | "$repo_root/bin/check-file-allowlist.sh" \
  || { echo "pre-commit: rejected (see above). Unstage with: git restore --staged <file>" >&2; exit 1; }
