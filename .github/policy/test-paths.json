{
 "comment": [
  "REQ-CI-001-AC3: the suites a pull request runs, by the files it changes, read by bin/select-tests.sh.",
  "paths are bash case patterns (* matches slashes); suites are shell commands, run in this order once each; a changed file that matches no entry fails the run.",
  "The last entry covers every tracked path by directory, with no suite of its own: the Go packages are tested by the test job, the rest by the entries above.",
  "full-suite.yml runs every suite named here, whole, nightly and before a release-candidate tag."
 ],
 "entries": [
  {
   "paths": [
    ".github/workflows/*",
    ".github/policy/*",
    ".github/dependabot.yml"
   ],
   "suites": [
    "bash bin/workflow-consolidation-test.sh",
    "bash bin/full-suite-wiring-test.sh",
    "bash bin/select-tests-test.sh",
    "bash bin/persona-uat-wiring-test.sh",
    "bash bin/dependency-lanes-test.sh",
    "bash bin/release-patch-wiring-test.sh",
    "bash bin/go-freshness-wiring-test.sh",
    "bash bin/job-isolation-test.sh",
    "bash bin/rescan-current-only-test.sh",
    "bash bin/panel-wiring-test.sh",
    "bash bin/scan-no-workflow-call-test.sh",
    "bash bin/admission-tag-signer-test.sh",
    "bash bin/acceptance-maven-413-test.sh",
    "bash bin/audit-record-test.sh",
    "python3 bin/check-workflow-permissions.py",
    "bash .github/agent/tests/pin-wiring-test.sh",
    "bash .github/agent/tests/pip-pin-test.sh",
    "bash .github/agent/tests/supply-chain-wiring-test.sh",
