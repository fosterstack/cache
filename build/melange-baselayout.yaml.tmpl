# The FosterStack Cache base layout (melange recipe): the small package that replaces Wolfi's wolfi-baselayout in
# the images, because wolfi-baselayout depends on ca-certificates-bundle (every r18..r30 in Wolfi's index) and the
# images carry no CA bundle (ops/docs/ratify/2026-10-28-no-ca-bundle-in-images.md, rule 1; handoff 0710).
#
# Rules (0710): the package holds only the files below, copied from build/baselayout/ in the source tree (real
# files, so a reader sees every byte); no dependency, no provides, no shell, no shell path (root and nobody have
# /sbin/nologin); /etc/os-release is Wolfi's own text so scanners identify the OS; version = fscache's version
# (@VERSION@ is replaced by bin/build-baselayout-apk.sh); the package pins below are GENERATED by bin/gen-recipes.py
# from build/locks/melange.lock and from build/melange-baselayout.yaml.tmpl (edit the template, never the recipe),
# and are the SAME list as build/melange.yaml; no network and no fetch; no symlink (melange's usrmerge linter
# refuses them), the image's links come from the image tool.
package:
  name: fscache-baselayout
  version: "@VERSION@"
  epoch: 0
  description: the base layout of the FosterStack Cache image (no CA bundle)
  copyright:
    - license: MIT
environment:
  contents:
    packages:
@PACKAGES@
pipeline:
  - runs: |
      mkdir -p ${{targets.destdir}}/etc ${{targets.destdir}}/usr/bin ${{targets.destdir}}/usr/lib
      mkdir -p ${{targets.destdir}}/dev ${{targets.destdir}}/proc ${{targets.destdir}}/sys ${{targets.destdir}}/run
      mkdir -p ${{targets.destdir}}/home ${{targets.destdir}}/root ${{targets.destdir}}/tmp ${{targets.destdir}}/var/tmp
      chmod 0700 ${{targets.destdir}}/root
      chmod 1777 ${{targets.destdir}}/tmp ${{targets.destdir}}/var/tmp
  - runs: |
      cp build/baselayout/etc/group build/baselayout/etc/hosts build/baselayout/etc/nsswitch.conf ${{targets.destdir}}/etc/
      cp build/baselayout/etc/os-release build/baselayout/etc/passwd build/baselayout/etc/protocols build/baselayout/etc/services ${{targets.destdir}}/etc/
      chmod 0644 ${{targets.destdir}}/etc/group ${{targets.destdir}}/etc/hosts ${{targets.destdir}}/etc/nsswitch.conf
      chmod 0644 ${{targets.destdir}}/etc/os-release ${{targets.destdir}}/etc/passwd ${{targets.destdir}}/etc/protocols ${{targets.destdir}}/etc/services
