# Test-only recipe of the sandbox wall probe (bin/chain-sandbox-probe.sh), wall: control. It is never published or signed. The probe renders
# it into a temporary folder (@BUSYBOX@, @RECORD@ and @KEYDIR@ are replaced there) and runs it through the sealed melange call.
package:
  name: probe-control
  version: 0.0.1
  epoch: 0
  description: test-only recipe of the sandbox wall probe, wall control
  copyright:
    - license: MIT
environment:
  contents:
    packages:
      - @BUSYBOX@
pipeline:
  - runs: |
      command -v cat
      command -v env
      command -v grep
      command -v wget
      ls -R /home/build
