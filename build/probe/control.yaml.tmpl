# Test-only recipe of the sandbox wall probe (bin/chain-sandbox-probe.sh), wall: control. Never published.
# The probe renders it into a temporary folder (@BUSYBOX@, @RECORD@, @KEYDIR@ are replaced there) and runs it sealed.
package:
  name: probe-control
  version: 0.0.1
  epoch: 0
  description: test-only recipe of the sandbox wall probe, wall control
  copyright:
    - license: MIT
environment:
  contents:
    packages:
      - @BUSYBOX@
pipeline:
  - runs: |
      command -v cat
      command -v env
      command -v grep
      command -v wget
      command -v cut
      cat /proc/net/route > /dev/null
      ls -R /home/build
