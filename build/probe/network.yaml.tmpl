# Test-only recipe of the sandbox wall probe (bin/chain-sandbox-probe.sh), wall: network. Never published.
# The probe renders it into a temporary folder (@BUSYBOX@ is replaced there) and runs it sealed.
# Any IPv4 route in /proc/net/route, or any IPv6 route in /proc/net/ipv6_route that is not on lo, means the namespace is open;
# the control reads both tables, so a sandbox without one is a probe error, never a held wall.
package:
  name: probe-network
  version: 0.0.1
  epoch: 0
  description: test-only recipe of the sandbox wall probe, wall network
  copyright:
    - license: MIT
environment:
  contents:
    packages:
      - @BUSYBOX@
pipeline:
  - runs: |
      if grep -qv '^Iface' /proc/net/route; then exit 1; fi
      if grep -qv ' lo$' /proc/net/ipv6_route; then exit 1; fi
