  version: 0.0.1
  epoch: 0
  description: test-only recipe of the sandbox wall probe, wall read-keydir
  copyright:
    - license: MIT
environment:
  contents:
    packages:
      - @BUSYBOX@
pipeline:
  - runs: |
      if cat @KEYDIR@/dummy > /dev/null; then exit 1; fi
