# Test-only recipe of the sandbox wall probe (bin/chain-sandbox-probe.sh), wall: read-record. Never published.
# The probe renders it into a temporary folder (@BUSYBOX@, @RECORD@, @KEYDIR@ are replaced there) and runs it sealed.
package:
  name: probe-read-record
  version: 0.0.1
  epoch: 0
  description: test-only recipe of the sandbox wall probe, wall read-record
  copyright:
    - license: MIT
environment:
  contents:
    packages:
      - @BUSYBOX@
pipeline:
  - runs: |
      if cat @RECORD@ > /dev/null; then exit 1; fi
      if cat /home/build/witness-apk/apk-collection.local.json > /dev/null; then exit 1; fi
