# Test-only recipe of the sandbox wall probe (bin/chain-sandbox-probe.sh), wall: read-token. Never published.
# The probe renders it into a temporary folder (@BUSYBOX@, @RECORD@, @KEYDIR@ are replaced there) and runs it sealed.
package:
  name: probe-read-token
  version: 0.0.1
  epoch: 0
  description: test-only recipe of the sandbox wall probe, wall read-token
  copyright:
    - license: MIT
environment:
  contents:
    packages:
      - @BUSYBOX@
pipeline:
  - runs: |
      if env | cut -d = -f 1 | grep -E 'ACTIONS_ID_TOKEN_REQUEST|ACTIONS_RUNTIME_TOKEN|GH_TOKEN|GITHUB_TOKEN'; then exit 1; fi
