# Test-only recipe of the sandbox wall probe (bin/chain-sandbox-probe.sh), wall: read-token. It is never published or signed. The probe renders
# it into a temporary folder (@BUSYBOX@, @RECORD@ and @KEYDIR@ are replaced there) and runs it through the sealed melange call.
package:
  name: probe-read-token
  version: 0.0.1
  epoch: 0
  description: test-only recipe of the sandbox wall probe, wall read-token
  copyright:
    - license: MIT
environment:
  contents:
    packages:
      - @BUSYBOX@
pipeline:
  - runs: |
      env | grep -E 'ACTIONS_ID_TOKEN_REQUEST|ACTIONS_RUNTIME_TOKEN|GH_TOKEN|GITHUB_TOKEN'
