# Test-only recipe of the sandbox wall probe (bin/chain-sandbox-probe.sh), wall: write-record. Never published.
# The probe renders it into a temporary folder (@BUSYBOX@, @RECORD@, @KEYDIR@ are replaced there) and runs it sealed.
package:
  name: probe-write-record
  version: 0.0.1
  epoch: 0
  description: test-only recipe of the sandbox wall probe, wall write-record
  copyright:
    - license: MIT
environment:
  contents:
    packages:
      - @BUSYBOX@
pipeline:
  - runs: |
      if echo forged >> @RECORD@; then exit 1; fi
