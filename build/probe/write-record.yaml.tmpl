# Test-only recipe of the sandbox wall probe (bin/chain-sandbox-probe.sh), wall: write-record. It is never published or signed. The probe renders
# it into a temporary folder (@BUSYBOX@, @RECORD@ and @KEYDIR@ are replaced there) and runs it through the sealed melange call.
package:
  name: probe-write-record
  version: 0.0.1
  epoch: 0
  description: test-only recipe of the sandbox wall probe, wall write-record
  copyright:
    - license: MIT
environment:
  contents:
    packages:
      - @BUSYBOX@
pipeline:
  - runs: |
      echo forged >> @RECORD@
