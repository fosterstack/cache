{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fosterstack.com/schemas/requirements/v1",
  "title": "FosterStack requirements file",
  "type": "object",
  "required": ["baseline", "requirements"],
  "additionalProperties": false,
  "properties": {
    "baseline": {
      "type": "object",
      "required": ["extracted_from", "extracted_on", "approved"],
      "additionalProperties": false,
      "properties": {
        "extracted_from": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "extracted_on": { "type": "string", "format": "date" },
        "approved": { "type": "boolean" },
        "approved_on": { "type": "string", "format": "date" },
        "note": { "type": "string" }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "statement", "source", "tier", "introduced",
                     "confidence", "acceptance_criteria"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[A-Z]+-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 3, "maxLength": 100 },
          "statement": { "type": "string", "minLength": 10 },
          "source": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "tier": { "enum": ["community", "team", "business", "compliance"] },
          "introduced": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "origin": { "type": "string" },
          "deprecated": { "type": "boolean" },
          "deprecated_reason": { "type": "string" },
          "confidence": {
            "enum": ["documented", "implementation-only", "claimed-unverified", "ambiguous"]
          },
          "notes": { "type": "string" },
          "acceptance_criteria": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "given", "when", "then", "verification", "status"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^REQ-[A-Z]+-[0-9]{3}-AC[0-9]+$" },
                "given": { "type": "string", "minLength": 3 },
                "when": { "type": "string", "minLength": 3 },
                "then": { "type": "string", "minLength": 3 },
                "verification": {
                  "type": "object",
                  "required": ["method"],
                  "additionalProperties": false,
                  "properties": {
                    "method": {
                      "enum": ["unit", "component", "integration", "http-integration",
                               "acceptance-gradle", "acceptance-maven",
                               "acceptance-container", "acceptance-release-artifact",
                               "ci-workflow", "manual", "inspection"]
                    },
                    "release_blocking": { "type": "boolean" }
                  }
                },
                "status": { "enum": ["proposed", "approved"] }
              }
            }
          }
        }
      }
    }
  }
}
